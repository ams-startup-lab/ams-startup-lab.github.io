---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import NewsItem from '../components/NewsItem.astro';
import { siteTexts, publications, news, events, fmtDate } from '../lib';
const site = await siteTexts();
const allPubs = await publications();
const allNews = await news();
const next = (await events()).upcoming[0];
const latest = allNews[0];
---
<Base>
  <section class="hero flush">
    <div class="pitch">
      <p class="mono">University of Amsterdam · Amsterdam Business School</p>
      <h1>Research on how startups really work.</h1>
      <p class="tagline">{site.hero.tagline}</p>
    </div>
    <div class="spot">
      {next ? (
        <>
          <p class="mono">Next event · {fmtDate(next.data.date)}</p>
          <h2>{next.data.title}</h2>
          <a class="mono" href="/events">Details →</a>
        </>
      ) : latest && (
        <>
          <p class="mono">Latest news · {fmtDate(latest.data.date)}</p>
          <h2>{latest.data.title}</h2>
          <a class="mono" href={latest.data.url} rel="noopener">Read →</a>
        </>
      )}
    </div>
  </section>

  <section class="about flush" aria-labelledby="about-h">
    <h2 id="about-h" class="bar mono">{site.about.heading}</h2>
    <div class="cols">
      {site.about.text.map((t: string, i: number) => (
        <div>
          <h3 class="mono">{site.about.labels?.[i]}</h3>
          <p>{t}</p>
          {i === 0 && <p class="mono go"><a href="/team">Meet the team →</a></p>}
          {i === site.about.text.length - 1 && <p class="mono go"><a href="#contact">Get in touch →</a></p>}
        </div>
      ))}
    </div>
  </section>

  <section class="flush">
    <div class="bar mono"><h2>Latest publications</h2><a href="/publications">All {allPubs.length} →</a></div>
    <ul>{allPubs.slice(0, 5).map((pub) => <PubItem pub={pub} />)}</ul>
  </section>

  <section class="flush">
    <div class="bar mono top"><h2>News and media</h2><a href="/news">All {allNews.length} →</a></div>
    <ul>{allNews.slice(0, 4).map((item) => <NewsItem item={item} />)}</ul>
  </section>

  <section id="contact" class="block top">
    <h2 class="label">{site.contact.heading}</h2>
    <div class="prose">
      <p>{site.contact.text}</p>
      <p><a href={site.contact.email_href}>{site.contact.email}</a><br />{site.contact.address}</p>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); border-bottom: var(--line); }
  .hero > div { padding: clamp(36px, 6vw, 64px) var(--gutter); }
  .hero h1 { font-size: clamp(32px, 4.8vw, 56px); margin-top: 16px; max-width: 14ch; }
  .tagline { margin-top: 20px; max-width: 48ch; color: var(--muted); }
  .spot { background: var(--hl); color: var(--hl-ink); border-left: var(--line); display: flex; flex-direction: column; justify-content: center; }
  .spot h2 { font-size: clamp(20px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em; margin: 12px 0 16px; }
  .spot a:hover { background: var(--hl-ink); color: var(--hl); }
  .top { border-top: var(--line); margin-top: -1px; }
  .about { border-bottom: var(--line); }
  .about .bar { margin: 0; font-weight: 400; }
  .about .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .about .cols > div { padding: 28px var(--gutter) 32px; display: flex; flex-direction: column; }
  .about .cols > div + div { border-left: 1px solid var(--rule); }
  .about h3 { color: var(--muted); font-weight: 400; margin-bottom: 12px; }
  .about p { font-size: 16px; line-height: 1.6; }
  .about .go { margin-top: auto; padding-top: 20px; font-size: 12px; }
  @media (max-width: 900px) {
    .about .cols { grid-template-columns: minmax(0, 1fr); }
    .about .cols > div + div { border-left: 0; border-top: 1px solid var(--rule); }
    .about .cols > div { padding-top: 22px; padding-bottom: 24px; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .spot { border-left: 0; border-top: var(--line); }
  }
</style>
