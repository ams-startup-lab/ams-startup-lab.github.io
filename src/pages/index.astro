---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import NewsItem from '../components/NewsItem.astro';
import Intro from '../components/Intro.astro';
import { getCollection } from 'astro:content';
import { siteTexts, publications, news, events, fmtDate, inline } from '../lib';
const site = await siteTexts();
const allPubs = await publications();
const allNews = await news();
const next = (await events()).upcoming[0];
const latest = allNews[0];
const hasNetwork = (await getCollection('network')).length > 0;
const last = site.about.text.length - 1;
const parts = (t: string) => { let k = 0; return inline(t).map((p) => ({ ...p, i: p.mark ? k++ : 0 })); };
---
<Base>
  <Intro />
  <section class="hero flush">
    <div class="pitch">
      <p class="mono">University of Amsterdam · Amsterdam Business School</p>
      <h1>Research on how startups really work.</h1>
      <p class="tagline">{site.hero.tagline}</p>
    </div>
    <div class="spot">
      {next ? (
        <>
          <p class="mono">Next event · {fmtDate(next.data.date)}</p>
          <h2>{next.data.title}</h2>
          <a class="mono" href="/activities/">Details →</a>
        </>
      ) : latest && (
        <>
          <p class="mono">Latest news · {fmtDate(latest.data.date)}</p>
          <h2>{latest.data.title}</h2>
          <a class="mono" href={latest.data.url} rel="noopener">Read →</a>
        </>
      )}
    </div>
  </section>

  <section class="about flush" aria-labelledby="about-h">
    <h2 id="about-h" class="bar mono">{site.about.heading}</h2>
    <div class="cols">
      {site.about.text.map((t: string, i: number) => (
        <div class={i === last ? 'work' : undefined}>
          <h3 class="mono">{i === last && <span class="pulse" aria-hidden="true"></span>}{site.about.labels?.[i]}</h3>
          <p>{parts(t).map((p) =>
            p.href ? (p.href.startsWith('/network/') && !hasNetwork ? p.text : <a href={p.href}>{p.text}</a>)
            : p.mark ? <span class="aud" style={`--i:${p.i}`}>{p.text}</span>
            : p.text)}</p>
          {i === 0 && <p class="mono go"><a href="/team/">Meet the team →</a></p>}
          {i === last && <p class="mono go"><a class="cta" href="#contact">Get in touch <span aria-hidden="true">→</span></a></p>}
        </div>
      ))}
    </div>
    <script is:inline>
      // Hide the Work with us panel before first paint, so its sweep can play (see the script below).
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector('.about .work')?.classList.add('pre');
    </script>
  </section>

  <section class="flush">
    <div class="bar mono"><h2>Latest publications</h2><a href="/publications/">All {allPubs.length} →</a></div>
    <ul>{allPubs.slice(0, 5).map((pub) => <PubItem pub={pub} />)}</ul>
  </section>

  <section class="flush">
    <div class="bar mono top"><h2>News and media</h2><a href="/news/">All {allNews.length} →</a></div>
    <ul>{allNews.slice(0, 4).map((item) => <NewsItem item={item} />)}</ul>
  </section>

  <section id="contact" class="contact flush top" aria-labelledby="contact-h">
    <h2 id="contact-h" class="bar mono">{site.contact.heading}</h2>
    <div class="prose">
      <p>{site.contact.text}</p>
      <p><a href={site.contact.email_href}>{site.contact.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); border-bottom: var(--line); }
  .hero > div { padding: clamp(36px, 6vw, 64px) var(--gutter); }
  .hero h1 { font-size: clamp(32px, 4.8vw, 56px); margin-top: 16px; max-width: 14ch; }
  .tagline { margin-top: 20px; max-width: 48ch; color: var(--muted); }
  .spot { background: linear-gradient(var(--hl), var(--hl)) no-repeat bottom / 100% 100%; color: var(--hl-ink); border-left: var(--line); display: flex; flex-direction: column; justify-content: center; transition: background-size .7s cubic-bezier(.65, 0, .35, 1), color .4s .3s; }
  /* The yellow drains down out of the news panel as it fills Work with us below (see the script). */
  .spot.drained { background-size: 100% 0%; color: var(--ink); }
  .spot.drained :focus-visible { outline-color: var(--ink); }
  .spot h2 { font-size: clamp(20px, 2.4vw, 26px); line-height: 1.2; letter-spacing: -0.01em; margin: 12px 0 16px; }
  .spot a:hover { background: var(--hl-ink); color: var(--hl); }
  .about { border-bottom: var(--line); }
  .about .bar, .contact .bar { margin: 0; font-weight: 400; }
  .contact .prose { padding: 28px var(--gutter) 40px; font-size: 16px; line-height: 1.6; }
  .about .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .about .cols > div { padding: 28px var(--gutter) 32px; display: flex; flex-direction: column; }
  .about .cols > div + div { border-left: 1px solid var(--rule); }
  .about h3 { color: var(--muted); font-weight: 400; margin-bottom: 12px; }
  .about p { font-size: 16px; line-height: 1.6; }
  .about .go { margin-top: auto; padding-top: 20px; font-size: 12px; }

  /* Work with us: a yellow panel that sweeps in like the intro's highlight, a pulsing
     "open" dot, audiences underlined one by one, and a solid call to action. */
  .about .cols > .work { color: var(--hl-ink); background: linear-gradient(var(--hl), var(--hl)) no-repeat left / 100% 100%; transition: background-size 1s cubic-bezier(.65, 0, .25, 1), color .6s .2s; }
  .about .cols > div + div.work { border-left: var(--line); }
  .about .cols > .work.pre { background-size: 0% 100%; color: var(--ink); transition: none; }
  .about .cols > .work.from-top { background-position: top; transition-delay: .35s, .5s; }
  .about .cols > .work.pre.from-top { background-size: 100% 0%; }
  .about .work h3 { color: inherit; display: flex; align-items: center; gap: 10px; }
  .pulse { position: relative; width: 10px; height: 10px; border-radius: 50%; background: currentColor; }
  .pulse::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid currentColor; opacity: 0; }
  .work.seen .pulse::after { animation: ping 1.8s ease-out .9s 4; }
  @keyframes ping { from { transform: scale(1); opacity: .9; } to { transform: scale(3); opacity: 0; } }
  .aud { font-weight: 600; background: linear-gradient(color-mix(in srgb, var(--hl-ink) 16%, transparent), color-mix(in srgb, var(--hl-ink) 16%, transparent)) no-repeat 0 88% / 100% .45em; transition: background-size .45s ease-out calc(1s + var(--i) * .22s); }
  .work.pre .aud { background-size: 0% .45em; }
  .work.from-top .aud { transition-delay: calc(1.3s + var(--i) * .22s); }
  .work a:hover { background: var(--hl-ink); color: var(--hl); }
  .work :focus-visible { outline-color: var(--hl-ink); }
  .work .cta { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; background: var(--hl-ink); color: var(--hl); text-decoration: none; font-size: 13px; }
  .work .cta span { transition: transform .2s; }
  .work .cta:hover span { transform: translateX(5px); }
  @media (prefers-reduced-motion: reduce) { .spot, .about .cols > .work, .aud, .work .cta span { transition: none; } .work.seen .pulse::after { animation: none; } }
  @media (max-width: 900px) {
    .about .cols { grid-template-columns: minmax(0, 1fr); }
    .about .cols > div + div { border-left: 0; border-top: 1px solid var(--rule); }
    .about .cols > div + div.work { border-left: 0; border-top: var(--line); }
    .about .cols > div { padding-top: 22px; padding-bottom: 24px; }
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .spot { border-left: 0; border-top: var(--line); }
  }
</style>

<script>
  // Play the Work with us sweep once, when the panel is in view (at load or on scroll).
  // If the yellow news panel is on screen too (wide layouts), the yellow moves: it drains
  // down out of the news panel and fills Work with us from the top. Otherwise it sweeps in from the left.
  const work = document.querySelector<HTMLElement>('.about .work.pre');
  const spot = document.querySelector<HTMLElement>('.hero .spot');
  if (work) {
    const io = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      const r = spot?.getBoundingClientRect();
      const transfer = spot && r && r.bottom > 40 && r.top < innerHeight && matchMedia('(min-width: 761px)').matches;
      if (transfer) work.classList.add('from-top');
      void work.offsetWidth;   // make the browser paint the start state first, or the sweep is skipped at page load
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (transfer) spot.classList.add('drained');
        work.classList.remove('pre'); work.classList.add('seen');
      }));
    }, { threshold: 0.4 });
    io.observe(work);
  }
</script>
