---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { siteTexts } from '../lib';
const intro = (await siteTexts()).page_intros.projects;
const people = Object.fromEntries((await getCollection('members')).map((m) => [m.id, m.data.name]));
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<Base title="Projects" description={intro.text}>
  <section class="page-head"><h1>{intro.heading}</h1><p>{intro.text}</p></section>
  <section class="flush">
    {rendered.map(({ p, Content }) => (
      <article class="project">
        <h2>{p.data.title}</h2>
        <p class="mono status">
          {p.data.status === 'completed' ? 'Completed' : 'Active'}
          {p.data.members.length > 0 && ` · ${p.data.members.map((id) => people[id] ?? id).join(', ')}`}
          {p.data.partners.length > 0 && ` · With ${p.data.partners.join(', ')}`}
        </p>
        <div class="prose"><Content /></div>
        {p.data.url && <p class="mono link"><a href={p.data.url}>More about this project →</a></p>}
      </article>
    ))}
  </section>
</Base>

<style>
  .project { padding: 36px var(--gutter) 40px; border-bottom: var(--line); }
  .project:last-child { border-bottom: 0; }
  .project h2 { font-size: clamp(24px, 3vw, 32px); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; max-width: 24ch; }
  .status { color: var(--muted); margin-top: 10px; line-height: 1.7; }
  .project .prose { margin-top: 18px; }
  .link { margin-top: 20px; }
</style>
