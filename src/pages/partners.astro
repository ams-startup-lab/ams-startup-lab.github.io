---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { siteTexts } from '../lib';
const intro = (await siteTexts()).page_intros.partners;
const people = Object.fromEntries((await getCollection('members')).map((m) => [m.id, m.data.name]));
const all = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const current = all.filter((p) => p.data.status === 'current');
const past = all.filter((p) => p.data.status === 'past');
const labels: Record<string, string> = {
  research: 'Research and data',
  ecosystem: 'Startup ecosystem and industry',
  teaching: 'Teaching',
};
const groups = Object.entries(labels)
  .map(([type, label]) => ({ label, items: current.filter((p) => p.data.type === type) }))
  .concat([{ label: 'Past partners', items: past }])
  .filter((g) => g.items.length);
---
<Base title="Partners" description={intro.text}>
  <section class="page-head"><h1>{intro.heading}</h1><p>{intro.text}</p></section>
  {groups.map((g) => (
    <section class="flush">
      <h2 class="bar mono">{g.label}</h2>
      <ul class="grid">
        {g.items.map(({ data: d }) => (
          <li>
            {d.logo && <a class="mark" href={d.url} aria-hidden="true" tabindex="-1"><img src={d.logo} alt="" loading="lazy" /></a>}
            <h3><a href={d.url}>{d.name}</a></h3>
            <p>{d.description}</p>
            <p class="mono meta">{d.members.map((id) => people[id] ?? id).join(', ')}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {all.length === 0 && <section class="block"><p>Our partner list is being prepared.</p></section>}
</Base>

<style>
  section.flush { border-bottom: var(--line); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .grid li { padding: 24px var(--gutter) 28px; border-bottom: 1px solid var(--rule); border-right: 1px solid var(--rule); display: flex; flex-direction: column; gap: 8px; }
  .mark { display: flex; align-items: center; height: 72px; padding: 12px 16px; background: #fff; color: #111; border: 1px solid var(--rule); text-decoration: none; margin-bottom: 8px; }
  .mark img { max-height: 44px; max-width: 180px; object-fit: contain; }
  .grid h3 { font-size: 21px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .grid h3 a { text-decoration: none; }
  .grid h3 a:hover { text-decoration: underline; }
  .grid p { font-size: 15px; color: var(--muted); }
  .grid .meta { margin-top: auto; padding-top: 6px; }
</style>
