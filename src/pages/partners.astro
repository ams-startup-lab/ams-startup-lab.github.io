---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { siteTexts } from '../lib';
const intro = (await siteTexts()).page_intros.partners;
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
---
<Base title="Partners" description={intro.text}>
  <section class="page-head"><h1>{intro.heading}</h1><p>{intro.text}</p></section>
  <section class="flush">
    {partners.length === 0 && <p class="block">Our partner list is being prepared.</p>}
    <ul class="wall">
      {partners.map(({ data: d }) => (
        <li>
          <a href={d.url} title={d.name}>
            {d.logo ? <img src={d.logo} alt={d.name} loading="lazy" /> : <span>{d.name}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  @media (max-width: 520px) { .wall { grid-template-columns: 1fr 1fr; } .wall a { padding: 16px; } .wall span { font-size: 16px; } }
  .wall li { border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .wall a { display: flex; align-items: center; justify-content: center; aspect-ratio: 3 / 2; padding: 24px; text-decoration: none; text-align: center; }
  .wall img { max-width: 100%; max-height: 64px; object-fit: contain; filter: grayscale(1); opacity: 0.85; transition: filter 0.2s, opacity 0.2s; }
  .wall a:hover img, .wall a:focus-visible img { filter: none; opacity: 1; }
  .wall span { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; line-height: 1.15; }
  @media (prefers-color-scheme: dark) { .wall img { filter: grayscale(1) invert(1); } .wall a:hover img { filter: none; } .wall a:hover { background: #fff; } }
</style>
