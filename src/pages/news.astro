---
import Base from '../layouts/Base.astro';
import NewsItem from '../components/NewsItem.astro';
import { siteTexts, news } from '../lib';
const intro = (await siteTexts()).page_intros.news;
const items = await news();
---
<Base title={intro.heading} description={intro.text}>
  <section class="page-head"><h1>{intro.heading}</h1><p>{intro.text}</p></section>
  <section class="flush"><h2 class="sr-only">All news</h2><ul>{items.map((item) => <NewsItem item={item} summary />)}</ul></section>
</Base>
