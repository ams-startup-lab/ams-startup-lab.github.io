---
import Base from '../layouts/Base.astro';
import { siteTexts, members } from '../lib';
const intro = (await siteTexts()).page_intros.team;
const { current, alumni } = await members();
const groups = [
  ['Faculty', current.filter((m) => m.data.group === 'faculty')],
  ['PhD candidates', current.filter((m) => m.data.group === 'phd')],
  ['Affiliates', current.filter((m) => m.data.group === 'affiliate')],
  ['Alumni', alumni],
] as const;
const initials = (name: string) => name.split(' ').filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
---
<Base title="Team" description={intro.text}>
  <section class="page-head"><div class="inner"><h1>{intro.heading}</h1><p>{intro.text}</p></div></section>
  {groups.filter(([, list]) => list.length > 0).map(([label, list]) => (
    <section class="group"><div class="inner">
      <h2 class="label">{label}</h2>
      <ul class="people">
        {list.map((m) => (
          <li>
            {m.data.photo
              ? <img src={m.data.photo} alt="" width="72" height="72" loading="lazy" />
              : <span class="avatar" aria-hidden="true">{initials(m.data.name)}</span>}
            <div>
              <h3>{m.data.name}</h3>
              <p class="meta">{m.data.title}{m.data.lab_role && ` · ${m.data.lab_role}`}</p>
              <p class="links">
                {m.data.uva_url && <a href={m.data.uva_url}>UvA profile</a>}
                {m.data.scholar_url && <a href={m.data.scholar_url}>Google Scholar</a>}
                {m.data.orcid && <a href={`https://orcid.org/${m.data.orcid}`}>ORCID</a>}
                {m.data.linkedin_url && <a href={m.data.linkedin_url}>LinkedIn</a>}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div></section>
  ))}
</Base>

<style>
  .group { padding-bottom: 40px; }
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 0 40px; }
  .people li { display: flex; gap: 16px; align-items: flex-start; padding: 20px 0; border-top: 1px solid var(--rule); }
  .people h3 { font-size: 20px; font-weight: 400; line-height: 1.25; }
  .avatar, .people img { flex: none; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; }
  .avatar { display: grid; place-items: center; background: var(--card); border: 1px solid var(--rule); font-family: var(--sans); font-size: 20px; color: var(--muted); }
  .links { font-family: var(--sans); font-size: 13px; margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px 14px; }
</style>
