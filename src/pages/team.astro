---
import Base from '../layouts/Base.astro';
import { siteTexts, members } from '../lib';
const intro = (await siteTexts()).page_intros.team;
const { current, alumni } = await members();
const groups = [
  ['Faculty', current.filter((m) => m.data.group === 'faculty')],
  ['PhD candidates', current.filter((m) => m.data.group === 'phd')],
  ['Affiliated researchers', current.filter((m) => m.data.group === 'affiliate')],
  ['Alumni', alumni],
] as const;
const initials = (name: string) => name.split(' ').filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
---
<Base title="Team" description={intro.text}>
  <section class="page-head"><h1>{intro.heading}</h1><p>{intro.text}</p></section>
  {groups.filter(([, list]) => list.length > 0).map(([label, list]) => (
    <section class="group flush">
      <div class="bar mono"><h2>{label}</h2><span>{list.length}</span></div>
      <ul class="people">
        {list.map((m) => (
          <li>
            {m.data.photo
              ? <img src={m.data.photo} alt="" width="72" height="72" loading="lazy" />
              : <span class="avatar" aria-hidden="true">{initials(m.data.name)}</span>}
            <div>
              <h3>{m.data.name}</h3>
              <p class="meta">{m.data.title}{m.data.lab_role && ` · ${m.data.lab_role}`}{m.data.affiliation && ` · ${m.data.affiliation}`}</p>
              <p class="links mono">
                {m.data.uva_url && <a href={m.data.uva_url}>UvA profile</a>}
                {m.data.affiliation_url && <a href={m.data.affiliation_url}>Profile</a>}
                {m.data.scholar_url && <a href={m.data.scholar_url}>Google Scholar</a>}
                {m.data.orcid && <a href={`https://orcid.org/${m.data.orcid}`}>ORCID</a>}
                {m.data.linkedin_url && <a href={m.data.linkedin_url}>LinkedIn</a>}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .group + .group .bar { border-top: var(--line); margin-top: -1px; }
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .people li { display: flex; gap: 16px; align-items: flex-start; padding: 22px var(--gutter); border-bottom: 1px solid var(--rule); }
  .people h3 { font-size: 18px; font-weight: 700; line-height: 1.25; }
  .avatar, .people img { flex: none; width: 64px; height: 64px; object-fit: cover; border: var(--line); }
  .avatar { display: grid; place-items: center; background: var(--hl); color: var(--hl-ink); font-family: var(--monof); font-size: 16px; }
  .links { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 0 14px; font-size: 11px; }
  .links a { display: inline-block; padding: 4px 0; }
</style>
