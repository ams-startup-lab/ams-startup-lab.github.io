---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="page-head">
    <h1>Page not found</h1>
    <p>This page does not exist, or it has moved. Try one of these:</p>
  </section>
  <section class="block">
    <ul class="mono go">
      <li><a href="/">Home</a></li>
      <li><a href="/team/">Team</a></li>
      <li><a href="/publications/">Publications</a></li>
      <li><a href="/activities/">Activities</a></li>
      <li><a href="/news/">News</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
  </section>
</Base>

<style>
  .go { display: flex; flex-direction: column; gap: 10px; font-size: 13px; }
  .go a { display: inline-block; padding: 4px 0; }
</style>
