---
import { fmtDate } from '../lib';
const { item, summary = false } = Astro.props;
const d = item.data;
---
<li class="item">
  <h3><a href={d.url} rel="noopener">{d.title}</a></h3>
  <p class="meta"><time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date)}</time> · {d.outlet}</p>
  {summary && d.summary && <p class="meta">{d.summary}</p>}
</li>
