---
import { pubMeta } from '../lib';
const { pub } = Astro.props;
const d = pub.data;
---
<li class="item" data-year={d.year} data-members={d.members.join(' ')}>
  <h3><a href={d.url} rel="noopener">{d.title}</a></h3>
  <p class="meta">{d.authors}</p>
  <p class="meta"><em>{pubMeta(d).split(' · ')[0]}</em> · {pubMeta(d).split(' · ')[1]}</p>
</li>
