---
import { getCollection } from 'astro:content';
import { siteTexts } from '../lib';
interface Props { title?: string; description?: string; noindex?: boolean }
const site = await siteTexts();
const { title, description = site.hero.tagline, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const hasNetwork = (await getCollection('network')).length > 0;
const nav = [
  ['Team', '/team/'], ['Publications', '/publications/'], ['Activities', '/activities/'],
  ...(hasNetwork ? [['Network', '/network/']] : []),
  ['News', '/news/'], ['Contact', '/#contact'],
];
const here = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- University of Amsterdam icon, taken from uva.nl -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Visitor statistics: https://ams-startup-lab.goatcounter.com (no cookies). Localhost is not counted. -->
    <script is:inline data-goatcounter="https://ams-startup-lab.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <script is:inline>
      // Count clicks on links to other sites (papers, press) as events, to show which content people open.
      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a[href^="http"]');
        if (!a || a.host === location.host || !window.goatcounter || !window.goatcounter.count) return;
        window.goatcounter.count({ path: a.href.replace(/^https?:\/\//, ''), title: a.textContent.trim().slice(0, 120), event: true });
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
    <header class="site">
      <a class="logo" href="/">{site.name}</a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([label, href]) => (
            <li><a href={href} aria-current={here === href ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site">
      <p class="mono">© {new Date().getFullYear()} {site.name} · University of Amsterdam · Amsterdam Business School</p>
      <p>{site.contact.address}</p>
      <p>We count visits with <a href="https://www.goatcounter.com">GoatCounter</a>. It uses no cookies and collects no personal information.</p>
    </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f4f1; --ink: #111; --muted: #555; --rule: #c9c9c2; --hl: #ffe14d; --hl-ink: #111; --card: #fff;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --monof: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --gutter: clamp(16px, 4vw, 40px);
    --line: 2px solid var(--ink);
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #131312; --ink: #f1f0ea; --muted: #a5a39b; --rule: #3a3935; --card: #1d1c1a; }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 17px; line-height: 1.55; }
  .page { max-width: 1200px; margin: 0 auto; min-height: 100vh; }
  @media (min-width: 1204px) { .page { border-left: var(--line); border-right: var(--line); } }
  a { color: inherit; text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  a:hover { background: var(--hl); color: var(--hl-ink); }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  /* On yellow panels, --ink is light in dark mode, so the ring uses the ink that sits on yellow. */
  .spot :focus-visible { outline-color: var(--hl-ink); }
  h1, h2, h3, p, ul { margin: 0; }
  ul { list-style: none; padding: 0; }
  [hidden] { display: none !important; }
  .skip { position: absolute; left: -999px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .skip:focus { left: 8px; top: 8px; background: var(--hl); color: var(--hl-ink); padding: 8px 12px; z-index: 10; }
  .mono { font-family: var(--monof); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }

  header.site, footer.site, main > section { padding-left: var(--gutter); padding-right: var(--gutter); }
  main > section.flush { padding-left: 0; padding-right: 0; }
  header.site { display: flex; justify-content: space-between; align-items: center; gap: 10px 24px; flex-wrap: wrap; padding-top: 18px; padding-bottom: 18px; border-bottom: var(--line); }
  .logo { font-weight: 800; font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; text-decoration: none; }
  header.site nav ul { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  header.site nav a { font-family: var(--monof); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; text-decoration: none; padding: 2px 0; }
  header.site nav a[aria-current="page"] { border-bottom: var(--line); }
  footer.site { border-top: var(--line); padding-top: 24px; padding-bottom: 40px; color: var(--muted); font-size: 14px; }
  footer.site p + p { margin-top: 6px; }

  .page-head { padding-top: 48px; padding-bottom: 40px; border-bottom: var(--line); }
  .page-head h1, .hero h1 { font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .page-head h1 { font-size: clamp(32px, 4.6vw, 52px); }
  .page-head p { color: var(--muted); margin-top: 12px; max-width: 60ch; }
  .bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px 16px; padding: 14px var(--gutter); border-bottom: var(--line); }
  .bar h2 { font: inherit; }
  .top { border-top: var(--line); margin-top: -1px; }
  .label { font-family: var(--monof); font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 14px; }
  .meta { font-size: 14px; color: var(--muted); margin-top: 4px; }

  /* Index rows: label | main | side */
  .row { display: grid; grid-template-columns: 96px minmax(0, 1fr) 240px; gap: 20px; padding: 16px var(--gutter); border-bottom: 1px solid var(--rule); align-items: baseline; }
  .row h3 { font-size: 17px; font-weight: 600; line-height: 1.3; }
  .row h3 a { text-decoration: none; }
  .row h3 a:hover { text-decoration: underline; }
  .row .side { text-align: right; color: var(--muted); }
  .row .lead { color: var(--muted); }
  @media (max-width: 760px) {
    .row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .row .side { text-align: left; }
  }
  .prose p + p { margin-top: 1em; }
  .prose { max-width: 68ch; }
  .block { padding-top: 40px; padding-bottom: 48px; border-bottom: var(--line); }
  main > section:last-child { border-bottom: 0; }
</style>
